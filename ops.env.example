# Deploy-specific settings + the ops dashboard basic_auth secret (security audit item 6).
#
# Copy this to ops.env ON THE DROPLET ONLY (it is gitignored — never commit the real
# file). Both compose services load it via `env_file`: Caddy reads FAIRTICK_DOMAIN,
# ACME_EMAIL and OPS_BASIC_AUTH_HASH from the Caddyfile; the backend reads
# FAIRTICK_APPLE_AUDIENCE.

# Public hostname Caddy serves (and gets a Let's Encrypt cert for).
FAIRTICK_DOMAIN=api.example.com
# Let's Encrypt account / expiry-notice email.
ACME_EMAIL=you@example.com
# Sign in with Apple audience = your iOS app's bundle id.
FAIRTICK_APPLE_AUDIENCE=com.example.yourgame

#
# Generate a fresh hash (bcrypt) on the droplet from a strong random password:
#   PASS=$(openssl rand -base64 18)
#   docker exec fairtick-caddy caddy hash-password --plaintext "$PASS"
# IMPORTANT: docker-compose env_file INTERPOLATES $ in values, so a raw bcrypt hash
# ($2a$14$...) gets mangled (the $-segments are read as empty vars). DOUBLE every $
# (turn each `$` into `$$`) when you paste the hash below. Keep the plaintext PASS in
# your password manager. The dashboard login is user "admin".
# Example: hash $2a$14$abcDEF...  ->  OPS_BASIC_AUTH_HASH=$$2a$$14$$abcDEF...
OPS_BASIC_AUTH_HASH=$$2a$$14$$replace_with_a_freshly_generated_bcrypt_hash
